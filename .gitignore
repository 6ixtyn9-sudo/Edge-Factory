# data — migrating to Supabase, never commit
# Broad ignores come FIRST so specific negations below can re-include files
# (in .gitignore, the LAST matching pattern wins).
*.csv
*.csv.gz
*.duckdb
*.duckdb.wal

# Ignore localdata contents entirely (directory is created at runtime).
localdata/*

# --- Negations: files that ARE committed to the repo ---
# Regenerated on each run; committed so they survive cache eviction.
!localdata/edges_consensus.json
!localdata/purity_registry.json

# Core pre-split history (immutable settled matches before 2025-06-01).
# These 3 concatenated files give CI the deep training history it needs to
# certify edges and assay purity WITHOUT any local intervention.
# ~37M total. Pre-split data never changes, so commit once = autonomous forever.
!localdata/forebet.csv.gz
!localdata/zulubet.csv.gz
!localdata/statarea.csv.gz

# B0 gap-aware re-mining coverage inventory (operator review artifact).
!localdata/coverage_inventory.json
!localdata/remine_audit_*.jsonl
!localdata/backfill_ledger.jsonl
!localdata/sa_hist_*.csv.gz

# Picks/performance snapshots intentionally committed for audit/review.
# Keep the rest of localdata ignored, but allow all generated picks outputs
# such as daily picks, audit reports, morning snapshots, rolling summaries,
# manifests, and today/next-2-days exports.
!localdata/picks*
# Addendum 21: settled-score facts shared across machines (bot-owned)
!localdata/settled_results.json

# Analysis artifacts intentionally committed for performance review.
!localdata/clv_*
!localdata/betexplorer_results_2026-*.csv.gz
!localdata/betexplorer_odds_2026-*.csv.gz
!localdata/sent_ledger_20*.json
!localdata/supabase_sync_manifest_20*.json

# secrets
.env
*.env
!.env.example

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
build/
dist/

# os/editor
.DS_Store
.idea/
.vscode/
!localdata/discovery_sent_ledger_20*.json
!localdata/enhancement_registry.json
!localdata/theoddsapi_usage.json
!localdata/theoddsapi_sports.json
!localdata/theoddsapi_attempts_20*.json
!localdata/theoddsapi_capture_20*.json
!localdata/theoddsapi_odds_2026-*.csv.gz
# Bounded OddsPAPI captures are a named-book receipt used by a later build.
!localdata/oddspapi_capture_20*.json
!localdata/oddspapi_odds_2026-*.csv.gz
# Round 3: the OddsPAPI market-id census and the served-catalog vocabulary
# snapshot are the DURABLE join-layer evidence (distinct market ids with
# classification/label/period/line, expected-vs-loss parse-skip split,
# unresolved-1x2 provider tuples). The "persist pipeline state" step runs
# `git add -A localdata/`, which silently drops ignored files - run
# 37138618268 (2026-10-03) wrote both and persisted neither until these
# negations existed. Provider data only; never credentials or URLs.
!localdata/oddspapi_market_census_*.json
!localdata/source_health/
!localdata/source_health/**
# The bounded BetExplorer snapshot is the raw receipt for its final-card rows.
!localdata/betexplorer_odds_cache_20*.json
!localdata/betexplorer_capture_20*.json
# Compact source-health receipts are the auditable attempt/join trail.  Raw
# shadow ledgers stay ignored: they can be large and are not needed to prove
# whether a source supplied a price.
!localdata/source_health_20*.json
!localdata/source_health_state.json
# BetMiner's one-call/day endpoint-contract receipt. It contains only endpoint,
# status, scrubbed schema keys/counts and timestamp (never a key or raw body).
!localdata/betminer_probe_20*.json

# Addendum 25: shadow-slate dedup ledger is bot-owned like the other ledgers
!localdata/shadow_sent_ledger_20*.json

# Truthfulness artifacts: silence-detector findings and delivery-failure
# ledgers persist so the operator can inspect history, not just logs.
!localdata/edge_firing_tripwire.json
!localdata/notify_delivery_failures_*.json

# Heavy-run completion is separate from future forecast archives. The bot uses
# this marker to guarantee one full capture/build/mine run per calendar day.
!localdata/official_run_20*.json

# Rolling auto-tickets state and slips (must persist across bot runs)
!localdata/auto_tickets_state.json
!localdata/auto_tickets_slice_ledger.jsonl
!localdata/auto_tickets_20*.txt
!localdata/auto_tickets_20*.json
# LEGACY freeze markers (pre OP-01 T2). The lock now lives write-once inside
# auto_tickets_state.json (`frozen_by_date`), which is already committed; no
# new .frozen files are created. Existing ones are still read for compat and
# are never deleted, so they stay allowlisted.
!localdata/auto_tickets_20*.frozen
!localdata/auto_tickets_performance.txt
!localdata/auto_tickets_performance.json
!localdata/auto_tickets_takeprofit_*.json

!localdata/o25_tracker_report.txt

# Curated team-name aliases for settlement lookup (hand-maintained, not generated)
!localdata/team_aliases.json

# Phase 5 forward-era evidence is required for the 90-day maturity clock.
# The existing daily pipeline already stages and persists all non-ignored localdata.
# Keep only these append-only capture ledgers durable; no workflow edits needed.
!localdata/phase5_shadow/
!localdata/phase5_shadow/rows.jsonl
!localdata/phase5_shadow/attempts.jsonl

# ML-fade research capture ledger + checkpoint state + checkpoint REPORTS
# (bot-owned, tracked so certification-independent evidence survives cache
# eviction — the pipeline's "persist pipeline state to git" step commits them
# every run). Reports moved from artifact-only to git-tracked per operator
# direction 2026-09-21 (audit trail like the CLV reports). One report set is
# written only when a checkpoint actually evaluates, never per-run.
!localdata/ml_fade_research_ledger.json
!localdata/ml_fade_research_state.json
!localdata/ml_fade_research_report_*.md
!localdata/ml_fade_checkpoint_contexts_*.txt
!localdata/ml_fade_checkpoint_price_study_*.txt
