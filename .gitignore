# data — migrating to Supabase, never commit
# Note: ignore directory CONTENTS (localdata/*), not the directory itself,
# otherwise git cannot re-include specific files via negation.
localdata/*
# Exception: commit the certified edge registry and purity registry so they
# survive cache eviction. Without these, a cold GitHub Actions run certifies
# 0 edges (no pre-split history) and clobbers a good registry, cascading into
# empty picks/WhatsApps. The purity registry's odds_band verdicts are the
# critical gate: without them, all picks land in WATCHLIST_UNKNOWN_CTX and
# are never pushed. Its keys are deterministic (no entity_registry dependency).
!localdata/edges_consensus.json
!localdata/purity_registry.json
*.csv
*.csv.gz
*.duckdb
*.duckdb.wal

# secrets
.env
*.env
!.env.example

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
build/
dist/

# os/editor
.DS_Store
.idea/
.vscode/
