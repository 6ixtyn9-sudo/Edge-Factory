# data — migrating to Supabase, never commit
# Note: ignore directory CONTENTS (localdata/*), not the directory itself,
# otherwise git cannot re-include specific files via negation.
localdata/*
# Exception: commit the certified edge registry so it survives cache eviction.
# Without this, a cold GitHub Actions run certifies 0 edges (no pre-split
# history) and clobbers a good registry, cascading into empty picks/WhatsApps.
!localdata/edges_consensus.json
*.csv
*.csv.gz
*.duckdb
*.duckdb.wal

# secrets
.env
*.env
!.env.example

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
build/
dist/

# os/editor
.DS_Store
.idea/
.vscode/
