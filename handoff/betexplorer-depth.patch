+        "lines": lines,
+        "rows": kept,
+        "rows_count": len(kept),
+        "named_rows": sum(1 for row in kept if row["bookmaker"]),
+        "bookmakers": sorted({row["bookmaker"] for row in kept if row["bookmaker"]}),
+        "average": average,
+        "average_by_line": average_by_line,
+    }
