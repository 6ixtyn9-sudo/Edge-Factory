+    """The settled slice table: by market, then by bucket, then by rule."""
+    from edgefactory.enh_registry import (UNATTRIBUTED, market_track_record,
+                                          slice_for_market)
+    root = root or ROOT
+    rows = [r for r in market_track_record(root) if r["n"]]
