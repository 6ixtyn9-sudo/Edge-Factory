# Operator-applied patch: enable the manual Run workflow button.
#
# The checked-in .github/workflows/daily.yml on this branch already contains
# workflow_dispatch (with the existing mode inputs). This diff is retained for
# an older deployed/operator copy that still has only the external trigger;
# do not apply it to a file that already has workflow_dispatch, or it will
# create a duplicate YAML key.
#
# Apply once through the GitHub web editor to the deployed workflow if needed.
# No workflow file is changed by this commit.
# Validation recipe for an older copy:
#   git apply --check docs/operator/enable-manual-dispatch.patch
#   git apply docs/operator/enable-manual-dispatch.patch

diff --git a/.github/workflows/daily.yml b/.github/workflows/daily.yml
--- a/.github/workflows/daily.yml
+++ b/.github/workflows/daily.yml
@@ -6,5 +6,6 @@
   # double-triggering alongside the external 09:00). Native schedule removed;
   # the external trigger is the single source of cadence.
+  workflow_dispatch:
 
 permissions:
   contents: write
