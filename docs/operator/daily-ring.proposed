name: Autonomous Edge Factory 3-Hour Service

on:
  # Scheduling is EXTERNAL (cron-job.org, SAST 09/12/15/18/21) — punctual to the
  # minute, which the 09:00 freeze depends on. GitHub's native cron fires 10-90
  # min late under load (observed 2026-09-04: 06:00 UTC slot fired 89 min late,
  # double-triggering alongside the external 09:00). Native schedule removed;
  # the external trigger is the single source of cadence.
  workflow_dispatch:
    inputs:
      mode:
        description: 'Execution Mode'
        required: false
        default: 'auto'
        type: choice
        options:
          - auto
          - official_morning
          - forecast_refresh
          - clv_only

permissions:
  contents: write

concurrency:
  group: edge-factory-main
  cancel-in-progress: false

jobs:
  run-autonomous-agent:
    runs-on: ubuntu-latest
    timeout-minutes: 360

    env:
      SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
      SUPABASE_SERVICE_KEY: ${{ secrets.SUPABASE_SERVICE_KEY }}
      BZZOIRO_TOKEN: ${{ secrets.BZZOIRO_TOKEN }}

      # SHADOW-01: one free RapidAPI key covers betminer (voice shadow) and
      # any future RapidAPI source. Absent key = adapters stay inert (not_run),
      # the suite stays green and the pick path is unaffected.
      RAPIDAPI_KEY: ${{ secrets.RAPIDAPI_KEY }}
      # BOGGIO KEY RING (production, 2026-10-10). boggio.configured_keys()
      # already prefers the ordered comma-separated RAPIDAPI_KEYS ring and
      # falls back to the singular RAPIDAPI_KEY, so this ONE line is the whole
      # wiring change: it lets the daily boggio shadow capture (~2.5 family
      # calls/day) rotate across both free pools instead of exhausting pool A
      # around 2026-10-22/23. Absent/empty secret = exactly today's behaviour
      # (singular key only), exactly as an unset ODDSPAPI_API_KEYS no-ops its
      # capture today. Same secret-name idiom as the verified shim line on main
      # (source-probe-dispatch.yml:32). Value never printed.
      RAPIDAPI_KEYS: ${{ secrets.RAPIDAPI_KEYS || '' }}
      # SHADOW-01: pinnapi (Pinnacle price shadow) uses its own free key.
      PINNAPI_KEY: ${{ secrets.PINNAPI_KEY }}

      # Bound the per-event odds fallback so one sparse Bzzoiro response cannot
      # consume the whole multi-source capture budget.
      BZZOIRO_ODDS_MAX_EVENTS: ${{ secrets.BZZOIRO_ODDS_MAX_EVENTS || '20' }}

      # Free multi-egress source relays.
      # EDGE_FACTORY_RELAY_URLS order:
      #   1. Cloudflare Worker
      #   2. Google Apps Script
      EDGE_FACTORY_RELAY_URLS: ${{ secrets.EDGE_FACTORY_RELAY_URLS }}
      EDGE_FACTORY_RELAY_TOKEN: ${{ secrets.EDGE_FACTORY_RELAY_TOKEN }}

      # Forebet Browser Run is deployed and contract-verified, but Forebet returned
      # 403 HTML/non-JSON for getrs.php. Keep it off in production so the daily
      # pipeline does not spend scarce Browser Run quota.
      EDGE_FACTORY_FOREBET_BROWSER: "off"

      TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
      TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}

      # The Odds API multi-key ring (comma-separated). Without this mapping the
      # capture step soft-no-ops on every Actions run (keys never reach env).
      ODDS_API_KEYS: ${{ secrets.ODDS_API_KEYS }}

      # Tuning knobs. '||' fallbacks mirror the code defaults (theoddsapi.py /
      # capture_theodds.py) so an unset or EMPTY secret is a no-op; secrets win
      # whenever they are set. (Addendum 20, 2026-08-03)
      ODDS_API_REGIONS: ${{ secrets.ODDS_API_REGIONS || 'eu' }}
      ODDS_API_MARKETS: ${{ secrets.ODDS_API_MARKETS || 'h2h,totals' }}
      ODDS_API_TOTAL_POINTS: ${{ secrets.ODDS_API_TOTAL_POINTS || '1.5,2.5,3.5,4.5' }}
      ODDS_API_MONTHLY_BUDGET: ${{ secrets.ODDS_API_MONTHLY_BUDGET || '480' }}
      ODDS_API_CLOSE_WINDOW_MIN: ${{ secrets.ODDS_API_CLOSE_WINDOW_MIN || '45' }}

      # SharpAPI (DIRECT, not the RapidAPI marketplace). Corrected 2026-10-06.
      #
      # History worth keeping, because it cost a fortnight: this source was
      # routed through the marketplace relay sharpapi1.p.rapidapi.com and
      # sent two credentials. The relay answered 401 with SharpAPI's OWN
      # envelope {"error":{"code":"disabled_api_key"}}, which was read as
      # "the gateway let us through and the origin rejected our key".
      # The real explanation is simpler: the operator's account is a direct
      # account and was never a marketplace account at all.
      #
      # The vendor playground shows the working contract:
      #   GET https://api.sharpapi.io/api/v1/odds?sport=soccer
      #   X-API-Key: <SHARPAPI_KEY>
      # One host, one header. RAPIDAPI_KEY is no longer used by this source.
      #
      # ENDPOINT: must be /api/v1/odds. The previous '/odds' default here was
      # a gateway-relative path and SILENTLY OVERRODE the adapter's correct
      # default, so the repair made in the adapter on 2026-10-03 never
      # actually reached production. Leaving this line out entirely would
      # also be correct; it is kept only so an operator can override it.
      SHARPAPI_SPORT: ${{ secrets.SHARPAPI_SPORT || 'soccer' }}
      SHARPAPI_ENDPOINT: ${{ secrets.SHARPAPI_ENDPOINT || '/api/v1/odds' }}
      SHARPAPI_LIMIT: ${{ secrets.SHARPAPI_LIMIT || '1000' }}
      # Optional server-side competition filter. HOLD THIS UNSET until a
      # run reports the vendor's own identifier for a competition we bet:
      # a wrong string is indistinguishable from an empty board, and the
      # committed board census now lists the identifiers verbatim, so the
      # value can be read off a measurement instead of guessed.
      SHARPAPI_LEAGUE: ${{ secrets.SHARPAPI_LEAGUE }}
      # The ONLY credential this source needs. Unset, the adapter does not
      # spend a call at all.
      SHARPAPI_KEY: ${{ secrets.SHARPAPI_KEY }}

      # OddsPAPI bounded candidate-snapshot capture (PRICE-LANE-TEARDOWN-2026-10-03).
      # Capture is ENABLED by default here now that the key secret is configured.
      # Set the EDGE_FACTORY_ODDSPAPI_PRICES secret to 'off' to disable without a
      # workflow edit. The key itself remains the hard guard: with no
      # ODDSPAPI_API_KEYS the capture still no-ops ("no ODDSPAPI_API_KEYS configured").
      ODDSPAPI_API_KEYS: ${{ secrets.ODDSPAPI_API_KEYS }}
      EDGE_FACTORY_ODDSPAPI_PRICES: ${{ secrets.EDGE_FACTORY_ODDSPAPI_PRICES || '1' }}
      ODDSPAPI_MAX_FIXTURES: ${{ secrets.ODDSPAPI_MAX_FIXTURES || '20' }}

      TZ: 'Africa/Johannesburg'

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.13'
          cache: 'pip'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install "supabase>=2.4,<3"

      - name: Restore localdata State (Cache)
        uses: actions/cache/restore@v4
        with:
          path: localdata
          key: localdata-v2-${{ github.run_id }}
          restore-keys: |
            localdata-v2-

      - name: Restore committed data (override stale cache)
        # Cache is only an optimization. Union the cached append-only Phase 5
        # ledgers with HEAD first; then restore every other tracked localdata
        # file. Keep the evidence directories out of git clean so a first or
        # conflicted capture cannot be erased before it is committed/artifacted.
        run: |
          set -e
          python3 scripts/phase5_persistence.py restore

          echo "certified edges present: $(python3 -c "import json;d=json.load(open('localdata/edges_consensus.json'));print(sum(1 for e in d.get('edges',[]) if e.get('status')=='certified'))" 2>/dev/null || echo n/a)"

      - name: Execute Autonomous Smart Schedule
        run: |
          if [ "${{ github.event_name }}" = "workflow_dispatch" ] && [ "${{ inputs.mode }}" != "auto" ]; then
            echo ">>> Executing explicit manual mode: ${{ inputs.mode }}"

            if [ "${{ inputs.mode }}" = "official_morning" ]; then
              PYTHONPATH=src python3 scripts/daily.py --force-repick
            elif [ "${{ inputs.mode }}" = "forecast_refresh" ]; then
              PYTHONPATH=src python3 scripts/daily.py --forecast-refresh
            elif [ "${{ inputs.mode }}" = "clv_only" ]; then
              PYTHONPATH=src python3 scripts/daily.py --clv-only
            fi
          else
            # Execute exactly one autonomous iteration of the smart accumulating ledger.
            PYTHONPATH=src python3 scripts/daily.py --auto-once
          fi

      - name: Phase 5 K-contract coverage (read-only diagnostic)          # <-- NEW
        # Which of the frozen 32 contract columns this run can fill, how much
        # captured evidence is only waiting on outcomes, and how many two-source
        # fixtures exist without any election-trio member (those can never
        # supply a target). Writes nothing; cannot mark the run red.
        if: always()
        continue-on-error: true
        run: |
          PYTHONPATH=src python3 scripts/fit_phase5_candidate.py --explain || true

      - name: Persist localdata State (Cache)
        uses: actions/cache/save@v4
        if: always()
        with:
          path: localdata
          key: localdata-v2-${{ github.run_id }}

      - name: Persist pipeline state to git (single source of truth)
        # Append-only Phase 5 JSONL conflicts are resolved as a stable union.
        # Other unrecoverable state conflicts are reported without force-push;
        # the always-uploaded artifact remains the recovery copy.
        if: always()
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          python3 scripts/phase5_persistence.py persist --run-id "${{ github.run_id }}"

      - name: Upload Pick Ledgers & Reports as Artifacts
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: EdgeFactory-Reports
          path: |
            localdata/*.txt
            localdata/*.json
            localdata/*.md
            localdata/phase5_shadow/**
            localdata/phase5_activation/**
            localdata/phase5_reconciliation/**
          retention-days: 7

      - name: Upload Scored-Candidate Audit Ledgers
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: Scored-Candidate-Audit-${{ github.run_id }}
          path: |
            localdata/scored_candidate_shadow_*.jsonl
          if-no-files-found: ignore
          retention-days: 30

  regression-tests:
    # Flag, never gate — and deliberately its OWN job, not a step at the end of
    # the pipeline job. A test failure can mark the run red but cannot withhold
    # the daily pipeline output.
    name: Regression tests (flag, never gate)
    runs-on: ubuntu-latest
    timeout-minutes: 30

    permissions:
      contents: read

    steps:
      - name: Checkout repository
        # Clean checkout: tracked files only, no pipeline cache or credentials.
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.13'
          cache: 'pip'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: pytest
        run: PYTHONPATH=src python3 -m pytest tests/ -q
