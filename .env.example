# Copy to .env and fill in. NEVER commit .env.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the service_role key for pipelines (server-side only!).
SUPABASE_SERVICE_KEY=eyJ...

# Politeness defaults (per-source overrides live in sources/*.py)
SCRAPE_MIN_DELAY_SECONDS=1.0
SCRAPE_MAX_RETRIES=3

# Optional: Telegram alerts for daily picks
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
