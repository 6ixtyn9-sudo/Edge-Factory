# Supabase read-model (service_role key, server-side only — never put in a client/app)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key...

# Real-book odds adapter
BZZOIRO_TOKEN=your_bzzoiro_api_token_here

# WhatsApp via CallMeBot (free personal alerts)
CALLMEBOT_APIKEY=123456789            # the key CallMeBot texts you after you authorize
CALLMEBOT_PHONE=27821234567           # full intl number, NO "+" and NO spaces (ZA = 27, drop leading 0)
# The Odds API (the-odds-api.com) — real-book h2h/totals prices for the frozen
# daily shortlist. Free tier = 500 credits/mo; adapter hard-stops at BUDGET.
# Capture (audit-only, no pick gating):
#   PYTHONPATH=src python3 scripts/capture_theodds.py            # pick-time snapshot
#   PYTHONPATH=src python3 scripts/capture_theodds.py --snapshot close
ODDS_API_KEYS=your_key_1,your_key_2,your_key_3   # rotation ring: a dead/exhausted key auto-fails-over
ODDS_API_CLOSE_WINDOW_MIN=45   # --auto close snapshot fires within this many min pre-kickoff
ODDS_API_REGIONS=eu             # one region keeps cost at markets x 1 per event
ODDS_API_MARKETS=h2h,totals     # add btts only if the enhancement registry needs it
ODDS_API_TOTAL_POINTS=2.5
ODDS_API_MONTHLY_BUDGET=480     # hard stop below the free 500


ODDSPAPI_API_KEYS=key1,key2,key3,key4