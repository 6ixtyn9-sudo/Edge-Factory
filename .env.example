# Supabase read-model (service_role key, server-side only — never put in a client/app)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key...

# Real-book odds adapter
BZZOIRO_TOKEN=your_bzzoiro_api_token_here

# WhatsApp via CallMeBot (free personal alerts)
CALLMEBOT_APIKEY=123456789            # the key CallMeBot texts you after you authorize
CALLMEBOT_PHONE=27821234567           # full intl number, NO "+" and NO spaces (ZA = 27, drop leading 0)