# Supabase read-model (service_role key, server-side only — never put in a client/app)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key...

# Real-book odds adapter
BZZOIRO_TOKEN=your_bzzoiro_api_token_here

# Free source-relay failover (Cloudflare Worker first, Apps Script second).
# Both relays use the same random token; requests are POSTed so it never enters URLs.
EDGE_FACTORY_RELAY_URLS=https://edge-factory-source-relay.YOU.workers.dev,https://script.google.com/macros/s/YOUR_DEPLOYMENT/exec
EDGE_FACTORY_RELAY_TOKEN=generate-a-long-random-value

# WhatsApp via CallMeBot (free personal alerts)
CALLMEBOT_APIKEY=123456789            # the key CallMeBot texts you after you authorize
CALLMEBOT_PHONE=27821234567           # full intl number, NO "+" and NO spaces (ZA = 27, drop leading 0)
# The Odds API (the-odds-api.com) — real-book h2h/totals prices for the frozen
# daily shortlist. Free tier = 500 credits/mo; adapter hard-stops at BUDGET.
# Capture (audit-only, no pick gating):
#   PYTHONPATH=src python3 scripts/capture_theodds.py            # pick-time snapshot
#   PYTHONPATH=src python3 scripts/capture_theodds.py --snapshot close
ODDS_API_KEYS=your_key_1,your_key_2,your_key_3   # rotation ring: a dead/exhausted key auto-fails-over
ODDS_API_CLOSE_WINDOW_MIN=45   # --auto close snapshot fires within this many min pre-kickoff
ODDS_API_REGIONS=eu             # free plan: h2h,spreads,totals only; 1 region keeps cost at markets x 1 per event
ODDS_API_MARKETS=h2h,totals
                           # each market = +1 credit/event (6 markets x 1 region = 6/event);
                           # drop markets via this knob if the monthly budget runs tight
ODDS_API_TOTAL_POINTS=1.5,2.5,3.5,4.5
ODDS_API_MONTHLY_BUDGET=480     # hard stop below the free 500


ODDSPAPI_API_KEYS=key1,key2,key3,key4

# SharpAPI (RapidAPI shadow price source). SHARPAPI_SPORT is required before
# capture; the adapter fails closed when it is unset. Never send a date
# parameter unless the provider confirms its name.
# SHARPAPI_SPORT=soccer
# SHARPAPI_ENDPOINT=/api/v1/odds
# SHARPAPI_LIMIT=100
# SHARPAPI_BOOK=
# SHARPAPI_MARKET=
# SHARPAPI_DATE_PARAM=

# Legacy Forebet/miner fallback is registered for audit but abstains from
# execution by default. Do not enable it without an operator decision.
# EDGE_FACTORY_ALLOW_SOURCE_FALLBACK=0
# EDGE_FACTORY_ENABLE_AVERAGE_PRICE_DONOR=1
# EDGE_FACTORY_ENABLE_FAIR_PRICE_DONOR=1
# EDGE_FACTORY_FAIR_PRICE_STAKEABLE=0